#!/bin/bash
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# Set macOS defaults
$ZSH/macos/set-defaults.sh

# Install homebrew
$ZSH/homebrew/install.sh 2>&1

# Trust third-party taps declared in the Brewfile so Homebrew will load their
# formulae. Homebrew refuses untrusted taps by default; parsing the Brewfile
# keeps this list self-maintaining.
#
# This has to run BEFORE update/upgrade, not just before bundle: `brew upgrade`
# skips packages from untrusted taps and warns about every one of them, so
# trusting afterwards left yabai/skhd and friends silently un-upgraded.
echo "› brew trust (Brewfile taps)"
while IFS= read -r tap; do
	[ -z "$tap" ] && continue
	echo "  trusting $tap"
	brew tap "$tap" >/dev/null 2>&1 || true
	brew trust --tap "$tap" >/dev/null 2>&1 || true
done < <(grep -E "^tap [\"']" "$dotfilesDirectory/Brewfile" \
	| sed -E "s/^tap [\"']([^\"']+)[\"'].*/\1/" \
	| sed -E 's|/homebrew-|/|')

# Upgrade homebrew
echo "› brew update"
brew update

# Upgrade outdated packages
echo "› brew upgrade"
brew upgrade

# Mac Apple Store Upgrade
if command -v mas &> /dev/null; then
  echo "› mas upgrade"
  mas upgrade
else
  echo "› mas not found, skipping Mac App Store upgrades"
fi

# brew bundle
echo "› brew bundle"
brew bundle install --file="$dotfilesDirectory/Brewfile"

# Re-run filetype bindings now that duti (from Brewfile) is guaranteed
# installed. On a fresh machine, the earlier set-defaults.sh call would have
# skipped this step. The aggregator is idempotent, so re-running is safe.
if [ -x "$dotfilesDirectory/macos/bind-filetypes.sh" ]; then
  echo "› bind-filetypes"
  "$dotfilesDirectory/macos/bind-filetypes.sh"
fi

# Update Node.js and npm. The body lives in node/update.sh — it was over half
# of this script — and never fails the run, matching the previous behaviour.
echo "› Updating Node.js and npm"
"$ZSH/node/update.sh" || echo "Node.js update had some issues, continuing with installation"

echo "› Starting post-install scripts"
# Install software
echo "› Running post-install scripts from $ZSH/script/install"
# Remember the outcome instead of printing a warning that the success banner
# then contradicts. script/install already reports which topics failed; dot's
# job is to not claim success over the top of it.
install_failed=0
"$ZSH/script/install" || install_failed=1

echo ""
if [ "$install_failed" -eq 0 ]; then
	echo "┌────────────────────────────────────────────┐"
	echo "│ dot script completed successfully!         │"
	echo "│ Your system is now up-to-date.             │"
	echo "└────────────────────────────────────────────┘"
else
	echo "┌────────────────────────────────────────────┐"
	echo "│ dot finished WITH FAILURES                 │"
	echo "│ See the post-install summary above.        │"
	echo "└────────────────────────────────────────────┘"
	exit 1
fi
