<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.helmedeiros.desktop-organizer</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROGRAM__</string>
    </array>

    <!-- Fire whenever the Desktop changes (file added/removed/renamed). -->
    <key>WatchPaths</key>
    <array>
        <string>__DESKTOP__</string>
    </array>

    <!-- Fallback sweep so items still inside their grace window get picked
         up even if nothing else touches the Desktop afterwards. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
